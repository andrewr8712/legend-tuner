<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude
            domain="file"
            path="backups" />
        <exclude
            domain="sharedpref"
            path="legend_tuner.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="backups" />
        <exclude
            domain="sharedpref"
            path="legend_tuner.xml" />
    </device-transfer>
</data-extraction-rules>
